# All env vars are OPTIONAL. With none set, Munshi runs in no-key demo mode
# (local IndexedDB storage, rule-based parsing, local OCR, browser speech).

# Supabase (production path)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM (optional, server-side only). GROQ_API_KEY enables Whisper voice
# transcription (/api/transcribe), few-shot LLM parsing (/api/parse) and /api/ask.
GROQ_API_KEY=
# Optional overrides. Defaults: parse=openai/gpt-oss-120b, ask/romanize=openai/gpt-oss-20b.
GROQ_MODEL=
GROQ_WHISPER_MODEL=whisper-large-v3
GEMINI_API_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=

# Web Push (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cron protection (optional)
CRON_SECRET=
